Options -Indexes
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^\.(.*)$ - [F,L,NC]
    RewriteRule ^(src|templates|data|database|deploy)(/|$) - [F,L,NC]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>
<IfModule mod_authz_core.c>
    <FilesMatch "^\.">
        Require all denied
    </FilesMatch>
</IfModule>
