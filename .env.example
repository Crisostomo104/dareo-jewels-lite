# Copy to .env and edit. Never commit the real .env.

# --- App ---
APP_ENV=local
APP_DEBUG=false
APP_URL=https://dareo-jewels.xo.je/lite
APP_TIMEZONE=Asia/Manila
FORCE_HTTPS=false

# --- Database ---
# sqlite (recommended for this lite build) or mysql
DB_DRIVER=sqlite
DB_PATH=data/app.sqlite
DB_HOST=localhost
DB_PORT=3306
DB_NAME=dareo_jewels
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# --- Session & security ---
SESSION_NAME=dareo_jewels_lite
SESSION_SECURE=false
SESSION_SAMESITE=Lax
SECURITY_HEADERS=true
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300

# --- Cloudflare Turnstile (login) ---
# Leave blank to disable captcha.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
